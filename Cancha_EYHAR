// ══════════════════════════════════
// ADMIN LOGIC
// ══════════════════════════════════
function saveAllCanchas() {
  document.querySelectorAll('[data-cid]').forEach(function(input) {
    var id = parseInt(input.dataset.cid);
    var field = input.dataset.field;
    var val = input.value;
    var c = appData.canchas.find(function(x){return x.id===id;});
    if (!c) return;
    if (field === 'precio') val = parseInt(val);
    else if (field === 'disponible') val = val === 'true';
    c[field] = val;
  });
  saveData();
  renderAll();
  showToast('✅ Canchas actualizadas en toda la app');
}

function saveAllTorneos() {
  document.querySelectorAll('[data-tid]').forEach(function(input) {
    var id = parseInt(input.dataset.tid);
    var field = input.dataset.field;
    var val = input.value;
    var t = appData.torneos.find(function(x){return x.id===id;});
    if (!t) return;
    if (field === 'precio' || field === 'cupos' || field === 'equipos') val = parseInt(val);
    t[field] = val;
  });
  saveData();
  renderAll();
  showToast('✅ Torneos actualizados en toda la app');
}

function saveConfig() {
  appData.config.ciudad = document.getElementById('cfg-ciudad').value;
  appData.config.appname = document.getElementById('cfg-appname').value;
  appData.config.whatsapp = document.getElementById('cfg-whatsapp').value;
  var newPass = document.getElementById('cfg-pass').value;
  if (newPass.length > 3) appData.config.pass = newPass;
  saveData();
  renderAll();
  showToast('✅ Configuración guardada');
}

function addCancha() {
  var newId = Date.now();
  appData.canchas.push({ id:newId, nombre:'Nueva Cancha', distrito:'Huánuco', distancia:'0 km', deportes:'Fútbol', precio:50, rating:4.0, disponible:true, emoji:'🟩', color:'bg-green' });
  saveData();
  renderAdminCanchas();
  showToast('➕ Cancha agregada — edita los datos');
  setTimeout(function() {
    var el = document.getElementById('admin-cancha-'+newId);
    if (el) el.scrollIntoView({behavior:'smooth'});
  }, 300);
}

function deleteCancha(id) {
  appData.canchas = appData.canchas.filter(function(c){return c.id!==id;});
  saveData();
  renderAdminCanchas();
  renderAll();
  showToast('🗑 Cancha eliminada');
}

function addTorneo() {
  var newId = Date.now();
  appData.torneos.push({ id:newId, nombre:'Nuevo Torneo', fecha:'Por definir', lugar:'Por definir', formato:'5v5', equipos:8, cupos:8, precio:40, nivel:'Principiante', emoji:'⚽', color:'#E8F5EE' });
  saveData();
  renderAdminTorneos();
  showToast('➕ Torneo agregado — edita los datos');
}

function deleteTorneo(id) {
  appData.torneos = appData.torneos.filter(function(t){return t.id!==id;});
  saveData();
  renderAdminTorneos();
  renderAll();
  showToast('🗑 Torneo eliminado');
}

function switchAdminTab(tab) {
  document.querySelectorAll('.admin-tab').forEach(function(t){t.classList.remove('active');});
  document.querySelectorAll('.admin-panel').forEach(function(p){p.classList.remove('active');});
  document.getElementById('admin-tab-'+tab).classList.add('active');
  event.target.classList.add('active');
}

// ══════════════════════════════════
// ACCESO SECRETO ADMIN
// ══════════════════════════════════
var adminTapCount = 0;
var adminTapTimer = null;
function adminTap() {
  adminTapCount++;
  clearTimeout(adminTapTimer);
  adminTapTimer = setTimeout(function(){adminTapCount=0;},2000);
  if (adminTapCount >= 5) {
    adminTapCount = 0;
    document.getElementById('admin-access-btn').style.display = 'flex';
    showToast('🔐 Modo admin desbloqueado');
  }
}

function goToAdmin() {
  document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});
  document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active');});
  document.getElementById('bottom-nav').style.display = 'none';
  document.getElementById('admin').classList.add('active');
  document.getElementById('admin-login').style.display = 'flex';
  document.getElementById('admin-content').style.display = 'none';
}

function checkAdminPass() {
  var input = document.getElementById('admin-pass-input');
  if (input.value === appData.config.pass) {
    document.getElementById('admin-login').style.display = 'none';
    document.getElementById('admin-content').style.display = 'block';
    renderAdminCanchas();
    renderAdminTorneos();
    document.getElementById('cfg-ciudad').value = appData.config.ciudad;
    document.getElementById('cfg-appname').value = appData.config.appname;
    document.getElementById('cfg-whatsapp').value = appData.config.whatsapp;
  } else {
    input.style.borderColor = '#E03535';
    showToast('❌ Contraseña incorrecta');
    setTimeout(function(){input.style.borderColor='';},1500);
  }
  input.value = '';
}

// ══════════════════════════════════
// NAVIGATION
// ══════════════════════════════════
var prevScreen = 'home';
var currentScreen = 'home';

function goTo(screen) {
  if (screen === 'reserva') prevScreen = currentScreen;
  document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});
  document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active');});
  document.getElementById('bottom-nav').style.display = 'flex';
  document.getElementById('mode-bar').style.display = 'none';
  var target = document.getElementById(screen);
  if (target) { target.classList.add('active'); target.scrollTop = 0; }
  var navItem = document.getElementById('nav-'+screen);
  if (navItem) navItem.classList.add('active');
  if (screen === 'reserva') document.getElementById('nav-canchas').classList.add('active');
  currentScreen = screen;
}

function goBack() { goTo(prevScreen || 'canchas'); }

function openReserva(id) {
  var c = appData.canchas.find(function(x){return x.id===id;});
  if (!c) return;
  document.getElementById('res-name').textContent = c.nombre;
  document.getElementById('res-sub').textContent = '📍 '+c.distrito+' · ★ '+c.rating+' · S/. '+c.precio+'/hora';
  document.getElementById('res-precio').textContent = 'S/. '+c.precio+'.00';
  document.getElementById('res-comision').textContent = 'S/. '+Math.round(c.precio*0.1)+'.00';
  document.getElementById('res-total').textContent = 'S/. '+Math.round(c.precio*1.1)+'.00';
  goTo('reserva');
}

function selectSport(el) {
  el.closest('.sport-select').querySelectorAll('.sport-btn').forEach(function(b){b.classList.remove('active');});
  el.classList.add('active');
}
function selectDate(el) {
  el.closest('.date-pills').querySelectorAll('.date-pill').forEach(function(p){p.classList.remove('active');});
  el.classList.add('active');
}
function selectTime(el) {
  if (el.classList.contains('taken')) return;
  el.closest('.time-grid').querySelectorAll('.time-slot').forEach(function(s){if(!s.classList.contains('taken'))s.classList.remove('active');});
  el.classList.add('active');
}
function showPago() { document.getElementById('modal-pago').classList.add('show'); }
function closePago(e) { if (e.target===document.getElementById('modal-pago')) document.getElementById('modal-pago').classList.remove('show'); }
function confirmReserva(method) {
  document.getElementById('modal-pago').classList.remove('show');
  showToast('✅ ¡Reserva confirmada con '+method+'! Te llegará confirmación por WhatsApp.');
  setTimeout(function(){goTo('home');},2500);
}
function showToast(msg) {
  var t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(function(){t.classList.remove('show');},3000);
}

document.querySelectorAll('.sport-pill').forEach(function(pill){
  pill.addEventListener('click',function(){
    document.querySelectorAll('.sport-pill').forEach(function(p){p.classList.remove('active');});
    this.classList.add('active');
  });
});
document.querySelectorAll('.filter-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.filter-btn').forEach(function(b){b.classList.remove('active');});
    this.classList.add('active');
  });
});

function enterOwnerMode() {
  document.getElementById('mode-bar').style.display='flex';
  document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});
  document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active');});
  var owner=document.getElementById('owner');
  owner.classList.add('active'); owner.scrollTop=0;
}
function toggleMode(isOwner) {
  if (!isOwner) {
    document.getElementById('mode-bar').style.display='none';
    document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});
    document.getElementById('home').classList.add('active');
    document.getElementById('nav-home').classList.add('active');
  }
}
function toggleDay(id) {
  var slots=document.getElementById('slots-'+id);
  var arrow=document.getElementById('arrow-'+id);
  if (!slots) return;
  var isOpen=slots.style.display!=='none';
  slots.style.display=isOpen?'none':'block';
  arrow.classList.toggle('open',!isOpen);
}
function cycleSlot(el) {
  if (el.classList.contains('slot-reservado')){showToast('No puedes cambiar una reserva ya pagada');return;}
  var states=['slot-libre','slot-bloqueado'];
  var labels=['Libre','Bloqueado'];
  var current=states.findIndex(function(s){return el.classList.contains(s);});
  var next=(current+1)%states.length;
  states.forEach(function(s){el.classList.remove(s);});
  el.classList.add(states[next]);
  el.textContent=labels[next];
  showToast(next===0?'Horario habilitado':'Horario bloqueado');
}

// Clock
function updateClock(){
  var now=new Date();
  var h=now.getHours().toString().padStart(2,'0');
  var m=now.getMinutes().toString().padStart(2,'0');
  document.getElementById('clock').textContent=h+':'+m;
}
updateClock(); setInterval(updateClock,30000);

// Add owner mode button to profile
window.addEventListener('load',function(){
  var menuSection=document.querySelectorAll('.menu-section')[1];
  if(menuSection){
    var item=document.createElement('div');
    item.className='menu-item';
    item.innerHTML='<div class="menu-icon amber">🏟️</div><div class="menu-text"><div class="menu-label">Modo dueño de cancha</div><div class="menu-sub">Gestiona tu cancha desde aquí</div></div><div class="menu-arrow">›</div>';
    item.onclick=function(){enterOwnerMode();showToast('Panel del dueño activado');};
    menuSection.appendChild(item);
  }
  renderAll();
  setTimeout(function(){
    document.getElementById('splash').style.opacity='0';
    setTimeout(function(){document.getElementById('splash').style.display='none';},500);
  },2000);
});
</script>
