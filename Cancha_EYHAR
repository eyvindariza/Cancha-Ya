<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cancha Ya — App</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
:root {
  --green: #1A7A4A;
  --green-light: #E8F5EE;
  --green-mid: #2EA865;
  --green-dark: #0F4D2E;
  --amber: #F5A623;
  --amber-light: #FEF3DC;
  --red: #E03535;
  --bg: #F2F4F0;
  --card: #FFFFFF;
  --text: #111B14;
  --text-2: #4A5C50;
  --text-3: #8A9E90;
  --border: #DDE8DF;
  --radius: 16px;
  --radius-sm: 10px;
}
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
body {
  font-family: 'DM Sans', sans-serif;
  background: #1A1A1A;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20px;
}
.phone-wrap {
  position: relative;
  width: 390px;
  height: 844px;
  background: var(--bg);
  border-radius: 44px;
  overflow: hidden;
  box-shadow: 0 40px 100px rgba(0,0,0,0.6), inset 0 0 0 1.5px rgba(255,255,255,0.08);
}
.status-bar {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 50px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 28px;
  z-index: 100;
  font-size: 12px;
  font-weight: 500;
  color: var(--text);
}
.status-bar .time { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 15px; }
.status-icons { display: flex; gap: 5px; align-items: center; }
.status-icons svg { width: 16px; height: 16px; fill: var(--text); }
.screen {
  position: absolute;
  inset: 0;
  overflow-y: auto;
  overflow-x: hidden;
  display: none;
  flex-direction: column;
  scroll-behavior: smooth;
  padding-top: 50px;
  padding-bottom: 80px;
}
.screen.active { display: flex; }
.screen::-webkit-scrollbar { display: none; }
.bottom-nav {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 80px;
  background: var(--card);
  border-top: 1px solid var(--border);
  display: flex;
  z-index: 100;
  padding-bottom: 14px;
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  cursor: pointer;
  transition: all 0.2s;
  padding-top: 10px;
}
.nav-item svg { width: 22px; height: 22px; stroke: var(--text-3); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: all 0.2s; }
.nav-item span { font-size: 10px; color: var(--text-3); font-weight: 500; transition: all 0.2s; }
.nav-item.active svg { stroke: var(--green); }
.nav-item.active span { color: var(--green); font-weight: 600; }

/* HOME */
#home { background: var(--bg); }
.home-header {
  background: var(--green-dark);
  padding: 16px 24px 28px;
  position: relative;
  overflow: hidden;
}
.home-header::before { content: ''; position: absolute; width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,0.04); top: -60px; right: -40px; }
.home-header::after { content: ''; position: absolute; width: 120px; height: 120px; border-radius: 50%; background: rgba(255,255,255,0.03); bottom: -30px; left: 60px; }
.greeting { font-size: 13px; color: rgba(255,255,255,0.6); font-weight: 300; margin-bottom: 2px; }
.user-name { font-family: 'Syne', sans-serif; font-size: 22px; color: #fff; font-weight: 700; margin-bottom: 16px; }
.location-row { display: flex; align-items: center; gap: 6px; }
.location-pill { background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.18); border-radius: 20px; padding: 5px 12px; font-size: 12px; color: rgba(255,255,255,0.85); display: flex; align-items: center; gap: 5px; }
.location-pill svg { width: 12px; height: 12px; stroke: #fff; fill: none; stroke-width: 2; }
.search-bar { margin: -18px 20px 0; position: relative; z-index: 10; }
.search-bar input { width: 100%; padding: 14px 18px 14px 44px; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--text); outline: none; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
.search-bar svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; stroke: var(--text-3); fill: none; stroke-width: 2; }
.section-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px 12px; }
.section-title { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 700; color: var(--text); }
.see-all { font-size: 13px; color: var(--green); font-weight: 500; cursor: pointer; }
.sport-pills { display: flex; gap: 8px; padding: 0 24px 16px; overflow-x: auto; }
.sport-pills::-webkit-scrollbar { display: none; }
.sport-pill { flex-shrink: 0; padding: 7px 16px; border-radius: 20px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; border: 1.5px solid var(--border); color: var(--text-2); background: var(--card); }
.sport-pill.active { background: var(--green); color: #fff; border-color: var(--green); }
.canchas-scroll { display: flex; gap: 14px; padding: 0 24px 4px; overflow-x: auto; }
.canchas-scroll::-webkit-scrollbar { display: none; }
.cancha-card { flex-shrink: 0; width: 220px; background: var(--card); border-radius: var(--radius); overflow: hidden; cursor: pointer; border: 1px solid var(--border); transition: transform 0.2s; }
.cancha-card:active { transform: scale(0.97); }
.cancha-img { width: 100%; height: 120px; position: relative; overflow: hidden; }
.cancha-img-bg { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 48px; }
.bg-green { background: linear-gradient(135deg, #1A7A4A 0%, #2EA865 100%); }
.bg-blue { background: linear-gradient(135deg, #1A4A7A 0%, #2E65A8 100%); }
.bg-amber { background: linear-gradient(135deg, #7A4A1A 0%, #A8652E 100%); }
.cancha-badge { position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.6); color: #fff; font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 10px; backdrop-filter: blur(4px); }
.cancha-badge.disponible { background: rgba(30,160,80,0.85); }
.cancha-badge.ocupado { background: rgba(220,50,50,0.85); }
.cancha-info { padding: 12px 14px; }
.cancha-name { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
.cancha-meta { font-size: 12px; color: var(--text-3); display: flex; align-items: center; gap: 4px; margin-bottom: 8px; }
.cancha-meta svg { width: 12px; height: 12px; stroke: var(--text-3); fill: none; stroke-width: 2; }
.cancha-footer { display: flex; justify-content: space-between; align-items: center; }
.cancha-price { font-size: 15px; font-weight: 600; color: var(--green); }
.cancha-price span { font-size: 11px; color: var(--text-3); font-weight: 400; }
.stars { font-size: 11px; color: var(--amber); }
.torneo-card { margin: 0 24px 14px; background: var(--card); border-radius: var(--radius); padding: 16px; cursor: pointer; border: 1px solid var(--border); display: flex; gap: 14px; align-items: center; transition: transform 0.2s; }
.torneo-card:active { transform: scale(0.98); }
.torneo-icon { width: 52px; height: 52px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 26px; flex-shrink: 0; }
.torneo-icon.fut { background: var(--green-light); }
.torneo-icon.vol { background: #EEF0FE; }
.torneo-info { flex: 1; }
.torneo-name { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
.torneo-sub { font-size: 12px; color: var(--text-3); }
.torneo-right { text-align: right; }
.torneo-price { font-size: 15px; font-weight: 600; color: var(--green); }
.torneo-spots { font-size: 11px; color: var(--text-3); margin-top: 2px; }

/* CANCHAS LIST */
#canchas { background: var(--bg); }
.screen-header { padding: 16px 24px 14px; background: var(--card); border-bottom: 1px solid var(--border); }
.screen-header-title { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800; color: var(--text); }
.screen-header-sub { font-size: 13px; color: var(--text-3); margin-top: 2px; }
.filter-row { display: flex; gap: 8px; padding: 14px 24px; overflow-x: auto; }
.filter-row::-webkit-scrollbar { display: none; }
.filter-btn { flex-shrink: 0; padding: 7px 14px; border-radius: 20px; font-size: 12px; font-weight: 500; border: 1.5px solid var(--border); background: var(--card); color: var(--text-2); cursor: pointer; transition: all 0.18s; }
.filter-btn.active { background: var(--green); color: #fff; border-color: var(--green); }
.cancha-list-item { margin: 0 20px 12px; background: var(--card); border-radius: var(--radius); padding: 14px; display: flex; gap: 14px; cursor: pointer; border: 1px solid var(--border); transition: transform 0.2s; }
.cancha-list-item:active { transform: scale(0.98); }
.cancha-thumb { width: 72px; height: 72px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 32px; flex-shrink: 0; }
.cancha-list-info { flex: 1; }
.cancha-list-name { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
.cancha-list-meta { font-size: 12px; color: var(--text-3); margin-bottom: 6px; }
.cancha-list-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.tag-pill { font-size: 10px; font-weight: 500; padding: 2px 8px; border-radius: 10px; background: var(--green-light); color: var(--green-dark); }
.tag-pill.voley { background: #EEF0FE; color: #3340B8; }
.tag-pill.full { background: var(--amber-light); color: #7A4F00; }
.cancha-list-right { text-align: right; display: flex; flex-direction: column; justify-content: space-between; }
.cancha-list-price { font-size: 16px; font-weight: 600; color: var(--green); }
.cancha-list-price small { font-size: 11px; color: var(--text-3); font-weight: 400; }
.avail-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
.avail-dot.on { background: var(--green-mid); }
.avail-dot.off { background: var(--red); }

/* RESERVA */
#reserva { background: var(--bg); }
.reserva-hero { background: var(--green-dark); padding: 16px 24px 24px; color: #fff; }
.back-btn { display: flex; align-items: center; gap: 6px; font-size: 13px; color: rgba(255,255,255,0.7); cursor: pointer; margin-bottom: 14px; }
.back-btn svg { width: 16px; height: 16px; stroke: rgba(255,255,255,0.7); fill: none; stroke-width: 2.5; }
.reserva-name { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; margin-bottom: 4px; }
.reserva-sub { font-size: 13px; color: rgba(255,255,255,0.65); }
.reserva-section { margin: 16px 20px 0; background: var(--card); border-radius: var(--radius); padding: 18px; border: 1px solid var(--border); }
.reserva-section-title { font-size: 12px; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 12px; }
.date-pills { display: flex; gap: 8px; overflow-x: auto; }
.date-pills::-webkit-scrollbar { display: none; }
.date-pill { flex-shrink: 0; padding: 10px 14px; border-radius: var(--radius-sm); border: 1.5px solid var(--border); cursor: pointer; text-align: center; transition: all 0.2s; min-width: 56px; }
.date-pill .day { font-size: 10px; color: var(--text-3); font-weight: 500; text-transform: uppercase; }
.date-pill .num { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 700; color: var(--text); margin-top: 2px; }
.date-pill.active { background: var(--green); border-color: var(--green); }
.date-pill.active .day, .date-pill.active .num { color: #fff; }
.time-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 4px; }
.time-slot { padding: 10px; border-radius: var(--radius-sm); border: 1.5px solid var(--border); text-align: center; cursor: pointer; font-size: 13px; font-weight: 500; color: var(--text); transition: all 0.2s; }
.time-slot.active { background: var(--green); color: #fff; border-color: var(--green); }
.time-slot.taken { background: var(--bg); color: var(--text-3); cursor: not-allowed; border-color: var(--border); text-decoration: line-through; }
.sport-select { display: flex; gap: 10px; }
.sport-btn { flex: 1; padding: 12px; border-radius: var(--radius-sm); border: 1.5px solid var(--border); text-align: center; cursor: pointer; font-size: 13px; font-weight: 500; color: var(--text); transition: all 0.2s; }
.sport-btn .icon { font-size: 22px; display: block; margin-bottom: 4px; }
.sport-btn.active { background: var(--green-light); border-color: var(--green); color: var(--green-dark); }
.precio-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 14px; color: var(--text-2); }
.precio-row:last-child { border-bottom: none; font-weight: 600; color: var(--text); font-size: 15px; }
.precio-row span:last-child { color: var(--green); }
.btn-primary { margin: 16px 20px; background: var(--green); color: #fff; border: none; border-radius: var(--radius); padding: 16px; font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; width: calc(100% - 40px); cursor: pointer; transition: all 0.2s; letter-spacing: 0.02em; }
.btn-primary:active { transform: scale(0.98); background: var(--green-dark); }

/* TORNEOS */
#torneos { background: var(--bg); }
.torneo-banner { margin: 14px 20px; background: var(--green-dark); border-radius: var(--radius); padding: 20px; position: relative; overflow: hidden; }
.torneo-banner::before { content: '⚽'; position: absolute; font-size: 80px; right: -10px; bottom: -14px; opacity: 0.15; }
.torneo-banner-label { font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
.torneo-banner-title { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800; color: #fff; margin-bottom: 8px; }
.torneo-banner-sub { font-size: 13px; color: rgba(255,255,255,0.65); margin-bottom: 14px; }
.btn-outline-white { display: inline-block; padding: 8px 18px; border: 1.5px solid rgba(255,255,255,0.4); border-radius: 20px; font-size: 13px; font-weight: 600; color: #fff; cursor: pointer; transition: all 0.2s; }
.btn-outline-white:active { background: rgba(255,255,255,0.1); }
.torneo-full-card { margin: 0 20px 14px; background: var(--card); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); cursor: pointer; transition: transform 0.2s; }
.torneo-full-card:active { transform: scale(0.98); }
.torneo-full-header { padding: 14px 16px; display: flex; gap: 12px; align-items: center; border-bottom: 1px solid var(--border); }
.torneo-full-icon { width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 22px; }
.torneo-full-name { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 700; color: var(--text); }
.torneo-full-meta { font-size: 12px; color: var(--text-3); margin-top: 2px; }
.torneo-level { margin-left: auto; padding: 4px 10px; border-radius: 10px; font-size: 11px; font-weight: 600; }
.level-basic { background: var(--green-light); color: var(--green-dark); }
.level-mid { background: var(--amber-light); color: #7A4F00; }
.level-pro { background: #FEE2E2; color: #7F1D1D; }
.torneo-full-body { padding: 14px 16px; }
.torneo-stats { display: flex; gap: 0; }
.torneo-stat { flex: 1; text-align: center; padding: 8px; border-right: 1px solid var(--border); }
.torneo-stat:last-child { border-right: none; }
.torneo-stat-val { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 700; color: var(--text); }
.torneo-stat-label { font-size: 10px; color: var(--text-3); font-weight: 500; text-transform: uppercase; margin-top: 2px; }
.inscribir-btn { margin: 10px 0 0; width: 100%; background: var(--green-light); color: var(--green-dark); border: none; border-radius: var(--radius-sm); padding: 11px; font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s; }
.inscribir-btn:active { background: var(--green); color: #fff; }

/* PERFIL */
#perfil { background: var(--bg); }
.perfil-header { background: var(--green-dark); padding: 20px 24px 30px; display: flex; flex-direction: column; align-items: center; position: relative; }
.avatar-ring { width: 80px; height: 80px; border-radius: 50%; background: var(--green-mid); display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800; color: #fff; margin-bottom: 10px; border: 3px solid rgba(255,255,255,0.3); }
.perfil-name { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 4px; }
.perfil-sub { font-size: 13px; color: rgba(255,255,255,0.6); }
.stats-row { display: flex; margin: -20px 20px 0; background: var(--card); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); position: relative; z-index: 5; }
.stat-item { flex: 1; padding: 16px 10px; text-align: center; border-right: 1px solid var(--border); }
.stat-item:last-child { border-right: none; }
.stat-num { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800; color: var(--text); }
.stat-lbl { font-size: 10px; color: var(--text-3); font-weight: 500; text-transform: uppercase; margin-top: 2px; }
.menu-section { margin: 16px 20px 0; background: var(--card); border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; }
.menu-item { display: flex; align-items: center; gap: 14px; padding: 15px 18px; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.15s; }
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: var(--bg); }
.menu-icon { width: 36px; height: 36px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 18px; }
.menu-icon.green { background: var(--green-light); }
.menu-icon.amber { background: var(--amber-light); }
.menu-icon.blue { background: #EEF0FE; }
.menu-icon.red { background: #FEE2E2; }
.menu-text { flex: 1; }
.menu-label { font-size: 14px; font-weight: 500; color: var(--text); }
.menu-sub { font-size: 12px; color: var(--text-3); margin-top: 1px; }
.menu-arrow { font-size: 16px; color: var(--text-3); }

/* OWNER PANEL */
.mode-toggle-bar { position: absolute; top: 50px; left: 0; right: 0; background: var(--green-dark); display: flex; align-items: center; justify-content: center; padding: 8px 20px; gap: 10px; z-index: 99; }
.mode-toggle-label { font-size: 12px; color: rgba(255,255,255,0.65); }
.toggle-switch { position: relative; width: 44px; height: 24px; cursor: pointer; }
.toggle-switch input { display: none; }
.toggle-track { width: 100%; height: 100%; background: rgba(255,255,255,0.2); border-radius: 12px; transition: background 0.2s; display: block; }
.toggle-thumb { position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; background: #fff; border-radius: 50%; transition: transform 0.2s; }
.toggle-switch input:checked ~ .toggle-track { background: var(--amber); }
.toggle-switch input:checked ~ .toggle-thumb { transform: translateX(20px); }
#owner { background: var(--bg); padding-top: 100px; }
.owner-header { background: var(--green-dark); padding: 14px 24px 22px; position: absolute; top: 50px; left: 0; right: 0; z-index: 50; }
.owner-badge { display: inline-flex; align-items: center; gap: 6px; background: var(--amber); color: #3D2000; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; margin-bottom: 8px; letter-spacing: 0.04em; text-transform: uppercase; }
.owner-name { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 800; color: #fff; }
.owner-sub { font-size: 13px; color: rgba(255,255,255,0.6); margin-top: 2px; }
.owner-kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 14px 20px 0; }
.kpi-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 16px; }
.kpi-label { font-size: 11px; color: var(--text-3); font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; }
.kpi-val { font-family: 'Syne', sans-serif; font-size: 26px; font-weight: 800; color: var(--text); }
.kpi-sub { font-size: 11px; color: var(--green); margin-top: 3px; }
.kpi-sub.neg { color: var(--red); }
.owner-section-title { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; color: var(--text); padding: 16px 20px 10px; }
.schedule-card { margin: 0 20px 14px; background: var(--card); border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; }
.schedule-day-header { display: flex; align-items: center; justify-content: space-between; padding: 13px 16px; border-bottom: 1px solid var(--border); cursor: pointer; }
.schedule-day-name { font-size: 14px; font-weight: 600; color: var(--text); }
.schedule-day-meta { font-size: 12px; color: var(--text-3); }
.schedule-day-arrow { font-size: 16px; color: var(--text-3); transition: transform 0.2s; }
.schedule-day-arrow.open { transform: rotate(90deg); }
.schedule-slots { padding: 12px 16px; }
.schedule-slot-row { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--border); }
.schedule-slot-row:last-child { border-bottom: none; }
