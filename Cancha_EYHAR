function saveData() { localStorage.setItem('canchaYaData', JSON.stringify(appData)); }

// ══════════════════════════════════
// RENDER
// ══════════════════════════════════
function renderAll() {
  renderHomeCanchas();
  renderHomeTorneos();
  renderCanchasList();
  renderTorneosList();
  renderAdminCanchas();
  renderAdminTorneos();
  document.getElementById('canchas-count').textContent = appData.canchas.length + ' canchas disponibles';
  document.getElementById('home-location').textContent = appData.config.ciudad;
}

function renderHomeCanchas() {
  var el = document.getElementById('home-canchas-scroll');
  el.innerHTML = appData.canchas.slice(0,4).map(function(c) {
    return '<div class="cancha-card" onclick="openReserva('+c.id+')">' +
      '<div class="cancha-img"><div class="cancha-img-bg '+c.color+'">'+c.emoji+'</div>' +
      '<div class="cancha-badge '+(c.disponible?'disponible':'ocupado')+'">'+(c.disponible?'● Disponible':'● Ocupado')+'</div></div>' +
      '<div class="cancha-info"><div class="cancha-name">'+c.nombre+'</div>' +
      '<div class="cancha-meta"><svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>'+c.distancia+' · '+c.distrito+'</div>' +
      '<div class="cancha-footer"><div class="cancha-price">S/.'+c.precio+' <span>/hora</span></div><div class="stars">★ '+c.rating+'</div></div></div></div>';
  }).join('');
}

function renderHomeTorneos() {
  var el = document.getElementById('home-torneos-list');
  el.innerHTML = appData.torneos.slice(0,2).map(function(t) {
    return '<div class="torneo-card" onclick="goTo(\'torneos\')">' +
      '<div class="torneo-icon" style="background:'+t.color+'">'+t.emoji+'</div>' +
      '<div class="torneo-info"><div class="torneo-name">'+t.nombre+'</div><div class="torneo-sub">'+t.fecha+' · Nivel '+t.nivel+'</div></div>' +
      '<div class="torneo-right"><div class="torneo-price">S/.'+t.precio+'</div><div class="torneo-spots">'+t.cupos+' cupos</div></div></div>';
  }).join('');
}

function renderCanchasList() {
  var el = document.getElementById('canchas-list');
  el.innerHTML = appData.canchas.map(function(c) {
    var deportesTags = c.deportes.split(',').map(function(d) {
      d = d.trim();
      var cls = d==='Vóley'?'voley':'';
      return '<span class="tag-pill '+cls+'">'+d+'</span>';
    }).join('');
    return '<div class="cancha-list-item" onclick="openReserva('+c.id+')">' +
      '<div class="cancha-thumb '+c.color+'" style="border-radius:10px">'+c.emoji+'</div>' +
      '<div class="cancha-list-info"><div class="cancha-list-name">'+c.nombre+'</div>' +
      '<div class="cancha-list-meta">📍 '+c.distancia+' · '+c.distrito+' · ★ '+c.rating+'</div>' +
      '<div class="cancha-list-tags">'+deportesTags+'</div></div>' +
      '<div class="cancha-list-right"><div class="cancha-list-price">S/.'+c.precio+'<small>/h</small></div>' +
      '<div><span class="avail-dot '+(c.disponible?'on':'off')+'"></span></div></div></div>';
  }).join('');
}

function renderTorneosList() {
  var el = document.getElementById('torneos-list');
  var levelClass = { 'Principiante':'level-basic','Intermedio':'level-mid','Pro':'level-pro' };
  el.innerHTML = appData.torneos.map(function(t) {
    return '<div class="torneo-full-card">' +
      '<div class="torneo-full-header">' +
      '<div class="torneo-full-icon" style="background:'+t.color+'">'+t.emoji+'</div>' +
      '<div><div class="torneo-full-name">'+t.nombre+'</div><div class="torneo-full-meta">'+t.fecha+' · '+t.lugar+'</div></div>' +
      '<div class="torneo-level '+(levelClass[t.nivel]||'level-basic')+'">'+t.nivel+'</div></div>' +
      '<div class="torneo-full-body"><div class="torneo-stats">' +
      '<div class="torneo-stat"><div class="torneo-stat-val">'+t.equipos+'</div><div class="torneo-stat-label">Equipos</div></div>' +
      '<div class="torneo-stat"><div class="torneo-stat-val">'+t.formato+'</div><div class="torneo-stat-label">Formato</div></div>' +
      '<div class="torneo-stat"><div class="torneo-stat-val">S/.'+t.precio+'</div><div class="torneo-stat-label">Inscripción</div></div>' +
      '<div class="torneo-stat"><div class="torneo-stat-val">'+t.cupos+'</div><div class="torneo-stat-label">Cupos</div></div>' +
      '</div><button class="inscribir-btn" onclick="showToast(\'¡Inscrito en '+t.nombre+'! '+t.emoji+'\')">Inscribir mi equipo →</button></div></div>';
  }).join('');
  if (appData.torneos[0]) {
    document.getElementById('banner-torneo-title').textContent = appData.torneos[0].nombre;
    document.getElementById('banner-torneo-sub').textContent = appData.torneos[0].fecha + ' · ' + appData.torneos[0].lugar;
  }
}

// ══════════════════════════════════
// ADMIN RENDER
// ══════════════════════════════════
function renderAdminCanchas() {
  var el = document.getElementById('admin-canchas-list');
  el.innerHTML = appData.canchas.map(function(c, i) {
    return '<div class="admin-card" id="admin-cancha-'+c.id+'">' +
      '<div class="admin-card-header">' +
      '<span class="admin-card-title"><span class="admin-card-num">'+(i+1)+'</span> '+c.emoji+' '+c.nombre+'</span>' +
      '<div class="admin-card-actions">' +
      '<button class="admin-action-btn danger" onclick="deleteCancha('+c.id+')">🗑 Eliminar</button>' +
      '</div></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Nombre</span><input class="admin-field-input" data-cid="'+c.id+'" data-field="nombre" value="'+c.nombre+'"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Distrito</span><input class="admin-field-input" data-cid="'+c.id+'" data-field="distrito" value="'+c.distrito+'"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Distancia</span><input class="admin-field-input" data-cid="'+c.id+'" data-field="distancia" value="'+c.distancia+'"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Deportes</span><input class="admin-field-input" data-cid="'+c.id+'" data-field="deportes" value="'+c.deportes+'" placeholder="Fútbol, Vóley"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Precio S/.</span><input class="admin-field-input" data-cid="'+c.id+'" data-field="precio" type="number" value="'+c.precio+'"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Emoji</span><input class="admin-field-input" data-cid="'+c.id+'" data-field="emoji" value="'+c.emoji+'"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Estado</span>' +
      '<select class="admin-field-select" data-cid="'+c.id+'" data-field="disponible">' +
