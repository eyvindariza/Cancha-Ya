      '<div class="admin-field-row"><span class="admin-field-label">Lugar</span><input class="admin-field-input" data-tid="'+t.id+'" data-field="lugar" value="'+t.lugar+'"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Precio S/.</span><input class="admin-field-input" data-tid="'+t.id+'" data-field="precio" type="number" value="'+t.precio+'"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Cupos</span><input class="admin-field-input" data-tid="'+t.id+'" data-field="cupos" type="number" value="'+t.cupos+'"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Formato</span><input class="admin-field-input" data-tid="'+t.id+'" data-field="formato" value="'+t.formato+'" placeholder="5v5"></div>' +
      '<div class="admin-field-row"><span class="admin-field-label">Nivel</span>' +
      '<select class="admin-field-select" data-tid="'+t.id+'" data-field="nivel">' +
      '<option'+(t.nivel==='Principiante'?' selected':'')+'>Principiante</option>' +
