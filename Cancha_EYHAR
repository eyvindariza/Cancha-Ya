    { id:1, nombre:'Copa Relámpago Fútbol', fecha:'Sáb 31 mayo', lugar:'Grass Arena Norte', formato:'5v5', equipos:8, cupos:3, precio:40, nivel:'Principiante', emoji:'⚽', color:'#E8F5EE' },
    { id:2, nombre:'Torneo Vóley Mixto', fecha:'Dom 1 jun', lugar:'Vóley Sport Center', formato:'6v6', equipos:12, cupos:5, precio:30, nivel:'Intermedio', emoji:'🏐', color:'#EEF0FE' },
    { id:3, nombre:'Liga Premier Fútbol', fecha:'Sáb 7 jun', lugar:'Grass Real Huánuco', formato:'7v7', equipos:16, cupos:2, precio:80, nivel:'Pro', emoji:'⚽', color:'#FEE2E2' }
